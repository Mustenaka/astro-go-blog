{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "to": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        }
      },
      "required": [
        "from"
      ],
      "additionalProperties": false
    },
    "role": {
      "type": "string"
    },
    "stack": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "repo": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "string",
              "pattern": "^\\/.*"
            }
          ]
        },
        "demo": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "string",
              "pattern": "^\\/.*"
            }
          ]
        },
        "post": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "string",
              "pattern": "^\\/.*"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "cover": {
      "type": "string",
      "pattern": "^\\/assets\\/.*"
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ]
          },
          "src": {
            "type": "string",
            "pattern": "^\\/assets\\/.*"
          },
          "poster": {
            "type": "string",
            "pattern": "^\\/assets\\/.*"
          },
          "caption": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "src"
        ],
        "additionalProperties": false
      }
    },
    "demo": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "island"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "iframe"
            },
            "src": {
              "type": "string",
              "minLength": 1
            },
            "aspect": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "src"
          ],
          "additionalProperties": false
        }
      ]
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "order": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "wip",
        "archived"
      ]
    }
  },
  "required": [
    "title",
    "summary",
    "period",
    "stack",
    "cover",
    "status"
  ],
  "additionalProperties": false,
  "$id": "https://mustenaka.cn/schema/works.schema.json",
  "title": "works",
  "description": "Front matter of content/works/<slug>.mdx (AGENTS.md 5.2)."
}
