# Copy to api/.env for local development. Loaded by godotenv only when the file exists.
# In production set real environment variables (systemd EnvironmentFile) and do not ship this file.

# Listen address. Production must stay on 127.0.0.1; Nginx forwards /api/v1/ only.
ADDR=127.0.0.1:8080

# SQLite database, uploaded files (local storage), build logs.
DATA_DIR=./data

# local | cos
STORAGE_KIND=local

# Tencent Cloud COS (only when STORAGE_KIND=cos)
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
# Public base for assets, e.g. https://cdn.example.com/assets . For local storage this is
# http://localhost:8080/assets and is derived automatically when empty.
ASSET_PUBLIC_BASE=

# Single admin account. Generate the hash with:  go run ./cmd/server hash-password
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# 32+ random bytes, hex or base64. Used to sign sessions and hash client IPs.
SESSION_SECRET=

# Repository paths (absolute or relative to the working directory).
CONTENT_DIR=../content
SITE_DIR=../site

# Script executed by the build trigger. .ps1 runs through PowerShell, .sh through sh.
RELEASE_SCRIPT=../deploy/scripts/release.dev.ps1

# GitHub push webhook secret (Settings -> Webhooks). Empty disables /hooks/github.
GITHUB_WEBHOOK_SECRET=

# Comma-separated origins allowed to call /api/v1/ from the browser. Empty allows none.
CORS_ORIGINS=http://localhost:4321

# Branch whose pushes trigger a build via the webhook.
MAIN_BRANCH=main
