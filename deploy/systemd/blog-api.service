# /etc/systemd/system/blog-api.service
# Go backend for the blog. Listens on 127.0.0.1:8080 only; Nginx forwards /api/v1/,
# everything else (admin, hooks, MCP) is reached through an SSH tunnel.
[Unit]
Description=Blog API (Go)
After=network.target

[Service]
Type=simple
User=blog
Group=blog
WorkingDirectory=/srv/blog
EnvironmentFile=/srv/blog/.env
ExecStart=/srv/blog/bin/blog-server
Restart=on-failure
RestartSec=3s
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/blog/data /srv/blog/site
UMask=0027

[Install]
WantedBy=multi-user.target
