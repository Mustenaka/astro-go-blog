# Copy to site/.env for local development. All values below are the dev defaults.

# Canonical site origin. Used for sitemap, RSS, canonical URLs.
PUBLIC_SITE_URL=http://localhost:4321

# Prefix that replaces "/assets/" in content at build time. In production this is the CDN origin.
PUBLIC_ASSET_BASE=http://localhost:8080/assets

# Go API origin. Empty string in production means same-origin.
PUBLIC_API_BASE=http://localhost:8080

# Artalk comment server origin. Leave empty to disable the comment island.
PUBLIC_ARTALK_SERVER=

# Set to "true" on staging so the temporary subdomain is not indexed.
PUBLIC_NOINDEX=false
