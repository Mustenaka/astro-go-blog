---
import '../styles/global.css';
import Seo, { type SeoProps } from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';

interface Props extends Omit<SeoProps, 'title'> {
  title: string;
  /** Use the title as-is instead of appending the site name. */
  rawTitle?: boolean;
  lang?: string;
  /** Load the self-hosted KaTeX stylesheet. Only pages with `math: true` set this. */
  math?: boolean;
}

const { title, rawTitle = false, lang = site.lang, math = false, ...seo } = Astro.props;
const fullTitle = rawTitle ? title : `${title} · ${site.name}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      /* Apply the stored theme before first paint to avoid a flash. */
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    <Seo title={fullTitle} {...seo} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {math && <link rel="stylesheet" href="/katex/katex.min.css" />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <Header />
    <main id="main" class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
