---
import '../styles/global.css';
// `?url` makes Vite emit the stylesheet (and its fonts) as a static asset without
// bundling it into every page; the link is only rendered when the page needs KaTeX.
import katexCssUrl from 'katex/dist/katex.min.css?url';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  math?: boolean;
}

const { title, description, lang = 'zh-CN', math = false } = Astro.props;
const noindex = import.meta.env.PUBLIC_NOINDEX === 'true';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {math && <link rel="stylesheet" href={katexCssUrl} />}
  </head>
  <body>
    <header>
      <nav>
        <a href="/">首页</a> · <a href="/works/adaptor-physx/">作品示例</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>木十 / Mustenaka · 阶段 1 临时布局</p>
    </footer>
  </body>
</html>
