---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  minDepth?: number;
  maxDepth?: number;
}

const { headings, minDepth = 2, maxDepth = 3 } = Astro.props;
const items = headings.filter((h) => h.depth >= minDepth && h.depth <= maxDepth);

interface Node {
  heading: MarkdownHeading;
  children: Node[];
}
const tree: Node[] = [];
const stack: Node[] = [];
for (const heading of items) {
  const node: Node = { heading, children: [] };
  while (stack.length && stack[stack.length - 1]!.heading.depth >= heading.depth) stack.pop();
  if (stack.length) stack[stack.length - 1]!.children.push(node);
  else tree.push(node);
  stack.push(node);
}
---

{
  tree.length > 0 && (
    <nav class="toc" aria-label="目录">
      <p class="toc-title">目录</p>
      <ol>
        {tree.map((node) => (
          <li>
            <a href={`#${node.heading.slug}`}>{node.heading.text}</a>
            {node.children.length > 0 && (
              <ol>
                {node.children.map((child) => (
                  <li>
                    <a href={`#${child.heading.slug}`}>{child.heading.text}</a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}
