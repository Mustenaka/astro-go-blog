---
/**
 * <head> metadata: canonical, Open Graph, Twitter cards and JSON-LD.
 * Every page goes through this component via the Base layout.
 */
import { absoluteUrl, noindex, site } from '../site.config';

export interface SeoProps {
  title: string;
  description?: string;
  /** Path of the page, e.g. `/posts/hello/`. Defaults to the current URL. */
  path?: string;
  type?: 'website' | 'article';
  /** Absolute URL or site path of the social image. */
  image?: string;
  article?: {
    publishedTime?: Date;
    modifiedTime?: Date;
    tags?: readonly string[];
    section?: string;
  };
  /** JSON-LD objects to embed, one <script> each. */
  jsonLd?: Record<string, unknown>[];
}

type Props = SeoProps;

const { title, description = site.description, path, type = 'website', image, article, jsonLd = [] } = Astro.props;

const canonical = absoluteUrl(path ?? Astro.url.pathname);
const ogImage = absoluteUrl(image ?? site.defaultOgImage);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta name="author" content={site.author.name} />

<meta property="og:site_name" content={site.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content="zh_CN" />
{article?.publishedTime && <meta property="article:published_time" content={article.publishedTime.toISOString()} />}
{article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
{article?.section && <meta property="article:section" content={article.section} />}
{article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
