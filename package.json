{
  "name": "astro-go-blog",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm -C site dev",
    "build": "pnpm -C site build",
    "check": "pnpm -C site check",
    "preview": "pnpm -C site preview",
    "build:admin": "pnpm -C admin build",
    "check:admin": "pnpm -C admin check",
    "api": "cd api && go run ./cmd/server",
    "api:test": "cd api && go vet ./... && go test ./..."
  }
}
